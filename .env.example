# Copy this file to `.env` and fill in your values. The `.env` file is git-ignored
# and must never be committed. Do not commit real secrets or API keys here — use
# placeholders and keep real values local.
FILE_SHARE_PATH=./data/financials
VALUATION_PDF_PATH=./data/valuation_parameters.pdf
OUTPUT_PATH=./data/output
OLLAMA_BASE_URL=http://localhost:11434

# Company name (optional — auto-detected from PDFs if omitted)
COMPANY_NAME=

# Vision Model Options:
# - llama3.2-vision:11b (recommended - best vision capabilities)
# - llama3.2-vision:90b (if you have the resources)
# - qwen2-vl:7b (alternative, good but less capable than llama3.2)
VISION_MODEL=qwen2.5vl:7b

# Analysis Model
ANALYSIS_MODEL=gpt-oss:20b

# Embedding Model
EMBEDDING_MODEL=nomic-embed-text:latest

# Optional API key (leave as NA if not used)
OPENAI_API_KEY=NA
